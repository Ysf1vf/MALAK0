      <!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>عيد ميلاد سعيد ❤️</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #12001f, #3b064f, #16001f);
            color: white;
            overflow-x: hidden;
        }

        .container {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 25px;
            text-align: center;
        }

        .card {
            width: 100%;
            max-width: 500px;
            padding: 35px 25px;
            border-radius: 30px;
            background: rgba(255, 255, 255, 0.09);
            border: 1px solid rgba(255,255,255,0.15);
            backdrop-filter: blur(12px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            animation: appear 1.2s ease;
        }

        .cake {
            font-size: 75px;
            margin-bottom: 15px;
            animation: bounce 2s infinite;
        }

        h1 {
            font-size: 34px;
            margin-bottom: 15px;
        }

        .name {
            color: #ff8bd8;
            font-size: 40px;
            margin-bottom: 20px;
        }

        .intro {
            color: #eee;
            font-size: 18px;
            line-height: 1.8;
            margin-bottom: 30px;
        }

        button {
            border: none;
            padding: 15px 30px;
            border-radius: 50px;
            background: linear-gradient(90deg, #ff4fa3, #a855f7);
            color: white;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(255, 79, 163, 0.35);
            transition: 0.3s;
        }

        button:hover {
            transform: scale(1.05);
        }

        #message {
            display: none;
            margin-top: 30px;
            animation: appear 1s ease;
        }

        #message h2 {
            color: #ff9cda;
            font-size: 28px;
            margin-bottom: 18px;
        }

        #message p {
            font-size: 18px;
            line-height: 2;
            color: #f5f5f5;
        }

        .photo {
            width: 100%;
            max-height: 300px;
            object-fit: cover;
            border-radius: 20px;
            margin-top: 25px;
            display: none;
        }

        .signature {
            margin-top: 25px;
            color: #ff9cda;
            font-size: 19px;
        }

        .heart {
            position: fixed;
            bottom: -30px;
            font-size: 20px;
            animation: floatUp linear forwards;
            pointer-events: none;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes bounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-12px);
            }
        }

        @keyframes floatUp {
            from {
                transform: translateY(0) rotate(0deg);
                opacity: 1;
            }

            to {
                transform: translateY(-110vh) rotate(360deg);
                opacity: 0;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="card">

            <div class="cake">🎂</div>

            <h1>كل سنة وأنتِ طيبة</h1>

            <!-- غيري الاسم هنا -->
            <div class="name"> يا اجمل ملاك ❤️</div>

            <p class="intro">
                النهارده مش يوم عادي...
                النهارده يوم مميز لأنه يوم ميلاد شخص مميز جدًا.
            </p>

            <button onclick="showMessage()">
                🎁 افتحي المفاجأة
            </button>

            <div id="message">

                <h2>🎉 مفاجأة! 🎉</h2>

                <p>
                    أتمنى السنة الجديدة من عمرك تكون مليانة
                    فرحة ونجاح وضحك وأيام حلوة كتير.
                    <br><br>
                    ويمكن الهدية بسيطة...
                    لكن أتمنى تكون قدرت ترسم ابتسامة على وشك ❤️
                </p>

                <!--
                لو عايز تضيف صورة:
                احذف display:none من .photo
                وضع اسم الصورة مكان birthday.jpg
                -->

                <img
                    class="photo"
                    src="birthday.jpg"
                    alt="ذكريات جميلة">

                <div class="signature">
                    من شخص بيتمنى لكِ كل الخير ❤️
                </div>

            </div>

        </div>

    </div>

    <script>

        function showMessage() {

            const message = document.getElementById("message");

            message.style.display = "block";

            createHearts();

            window.scrollTo({
                top: document.body.scrollHeight,
                behavior: "smooth"
            });
        }


        function createHearts() {

            for (let i = 0; i < 25; i++) {

                setTimeout(() => {

                    const heart = document.createElement("div");

                    heart.className = "heart";

                    heart.innerHTML =
                        ["❤️", "💗", "💕", "💖", "✨"][Math.floor(Math.random() * 5)];

                    heart.style.left =
                        Math.random() * 100 + "vw";

                    heart.style.animationDuration =
                        (3 + Math.random() * 4) + "s";

                    heart.style.fontSize =
                        (15 + Math.random() * 25) + "px";

                    document.body.appendChild(heart);

                    setTimeout(() => {
                        heart.remove();
                    }, 7000);

                }, i * 100);
            }
        }

    </script>

</body>
</html>